#!/usr/bin/env bash
# koodex: run OpenAI Codex CLI in an isolated container.
#
# Usage:
#   koodex [DIR]            run codex in Auto mode: workspace-write sandbox, approval
#                           on request (default)
#   koodex -s [DIR]         run codex read-only, approval on request
#   koodex -y [DIR]         run codex with --dangerously-bypass-approvals-and-sandbox (YOLO)
#   koodex -A [DIR]         also forward the host SSH agent (1Password); off by default
#   koodex --shell [DIR]    drop into a zsh shell in the container
#
# Flags can be combined, e.g. `koodex -s -A .`.
#
# DIR defaults to ~/workspace. Mounts:
#   <workspace>     -> /workspace
#   ~/workspace     -> /home/node/workspace (if present)
#   ~/Github        -> /home/node/Github (all code projects, if present)
#   ~/.codex        -> /home/node/.codex (Codex config + credentials)
#   ~/.gitconfig    -> /home/node/.gitconfig (ro, if present)
#   host SSH agent  -> /ssh-agent (only with -A/--ssh; 1Password / SSH keys)
#   named volume    -> /commandhistory (persistent shell history)
#
# MCP servers listed in host_only_mcp (default: node_repl) are disabled for the
# run, because their binaries live on the macOS host only.
#
# OPENAI_API_KEY is forwarded into the container if it is set in your environment.

set -euo pipefail

mode="auto"
ssh_forward=0
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -s|--safe)    mode="safe";  shift ;;
        -y|--yolo)    mode="bypass"; shift ;;
        -A|--ssh)     ssh_forward=1; shift ;;
        --shell)      mode="shell"; shift ;;
        -h|--help)    sed -n '2,/^set -/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^set -/d'; exit 0 ;;
        --)           shift; break ;;
        *)            echo "koodex: unknown flag: $1" >&2; exit 2 ;;
    esac
done

# Default workspace is ~/workspace on the host (mounted at /workspace, the
# container's working dir). Pass an explicit DIR (or `koodex .`) for another project.
default_workspace="$HOME/workspace"
mkdir -p "$default_workspace"
workspace="${1:-$default_workspace}"
[[ -d "$workspace" ]] || { echo "koodex: $workspace is not a directory" >&2; exit 1; }
workspace="$(cd "$workspace" && pwd)"

name="koodex-$(basename "$workspace" | tr -c 'a-zA-Z0-9_-' '_')-$$"

# SSH agent / 1Password forwarding is opt-in (-A/--ssh); off by default.
ssh_args=()
if [[ "$ssh_forward" == 1 ]]; then
    # Docker Desktop / OrbStack expose the host SSH agent here on macOS.
    ssh_sock="/run/host-services/ssh-auth.sock"
    if [[ ! -S "$ssh_sock" ]]; then
        ssh_sock="${SSH_AUTH_SOCK:-}"
    fi
    if [[ -z "$ssh_sock" || ! -S "$ssh_sock" ]]; then
        echo "koodex: no SSH agent socket found; SSH forwarding disabled" >&2
    else
        ssh_args=(-v "$ssh_sock:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent)
    fi
fi

mkdir -p "$HOME/.codex"

# Forward OPENAI_API_KEY if set (alternative to `codex login` in ~/.codex).
codex_env=()
[[ -n "${OPENAI_API_KEY:-}" ]] && codex_env=(-e OPENAI_API_KEY)

gitconfig_args=()
[[ -f "$HOME/.gitconfig" ]] && gitconfig_args=(-v "$HOME/.gitconfig:/home/node/.gitconfig:ro")

github_args=()
[[ -d "$HOME/Github" ]] && github_args=(-v "$HOME/Github:/home/node/Github")

workspace_home_args=()
[[ -d "$HOME/workspace" ]] && workspace_home_args=(-v "$HOME/workspace:/home/node/workspace")

# MCP servers that live only on the macOS host cannot start in the container.
# `node_repl` ships inside the ChatGPT desktop app (a Mach-O binary under
# /Applications), so Codex reports "MCP startup failed: No such file or
# directory". Disable them per run; ~/.codex/config.toml stays untouched.
# Add more names here if other host-only servers appear.
host_only_mcp=(node_repl)
mcp_args=()
for server in "${host_only_mcp[@]}"; do
    mcp_args+=(-c "mcp_servers.${server}.enabled=false")
done

case "$mode" in
    auto)   cmd=(codex ${mcp_args[@]+"${mcp_args[@]}"} --sandbox workspace-write --ask-for-approval on-request) ;;
    safe)   cmd=(codex ${mcp_args[@]+"${mcp_args[@]}"} --sandbox read-only --ask-for-approval on-request) ;;
    bypass) cmd=(codex ${mcp_args[@]+"${mcp_args[@]}"} --dangerously-bypass-approvals-and-sandbox) ;;
    shell)  cmd=(/bin/zsh) ;;
esac

# The agent's own sandbox (bubblewrap) needs to create user namespaces, which
# Docker's default seccomp profile blocks. Without this the sandboxed commands
# fail with "bwrap: No permissions to create new namespace".
exec docker run --rm -it \
    --security-opt seccomp=unconfined \
    --name "$name" \
    --hostname "$(basename "$workspace")" \
    -v "$workspace:/workspace" \
    -v "$HOME/.codex:/home/node/.codex" \
    -v koodex-history:/commandhistory \
    ${codex_env[@]+"${codex_env[@]}"} \
    ${workspace_home_args[@]+"${workspace_home_args[@]}"} \
    ${github_args[@]+"${github_args[@]}"} \
    ${gitconfig_args[@]+"${gitconfig_args[@]}"} \
    ${ssh_args[@]+"${ssh_args[@]}"} \
    -e TERM="${TERM:-xterm-256color}" \
    -w /workspace \
    koodex:latest "${cmd[@]}"
