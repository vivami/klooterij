#!/usr/bin/env bash
# kloot: run Claude Code in an isolated container.
#
# Usage:
#   kloot [DIR]            run claude with --permission-mode auto (default)
#   kloot -s [DIR]         run claude with --permission-mode manual (prompt on every action)
#   kloot -y [DIR]         run claude with --dangerously-skip-permissions (YOLO)
#   kloot -A [DIR]         also forward the host SSH agent (1Password); off by default
#   kloot --shell [DIR]    drop into a zsh shell in the container
#
# Flags can be combined, e.g. `kloot -s -A .`.
#
# DIR defaults to ~/workspace. Mounts:
#   <workspace>     -> /workspace
#   ~/workspace     -> /home/node/workspace (if present)
#   ~/Github        -> /home/node/Github (all code projects, if present)
#   CleanShot media -> same absolute host path (ro, if present; supports drag/drop)
#   ~/.claude       -> /home/node/.claude
#   ~/.claude.json  -> /home/node/.claude.json (if present)
#   ~/.gitconfig    -> /home/node/.gitconfig (ro, if present)
#   host SSH agent  -> /ssh-agent (only with -A/--ssh; 1Password / SSH keys)
#   named volume    -> /commandhistory (persistent shell history)

set -euo pipefail

mode="auto"
ssh_forward=0
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -s|--safe)    mode="safe";  shift ;;
        -y|--yolo)    mode="bypass"; shift ;;
        -A|--ssh)     ssh_forward=1; shift ;;
        --shell)      mode="shell"; shift ;;
        -h|--help)    sed -n '2,/^set -/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^set -/d'; exit 0 ;;
        --)           shift; break ;;
        *)            echo "kloot: unknown flag: $1" >&2; exit 2 ;;
    esac
done

# Default workspace is ~/workspace on the host (mounted at /workspace, the
# container's working dir). Pass an explicit DIR (or `kloot .`) for another project.
default_workspace="$HOME/workspace"
mkdir -p "$default_workspace"
workspace="${1:-$default_workspace}"
[[ -d "$workspace" ]] || { echo "kloot: $workspace is not a directory" >&2; exit 1; }
workspace="$(cd "$workspace" && pwd)"

name="kloot-$(basename "$workspace" | tr -c 'a-zA-Z0-9_-' '_')-$$"

# SSH agent / 1Password forwarding is opt-in (-A/--ssh); off by default.
ssh_args=()
orbstack_args=()
if [[ "$ssh_forward" == 1 ]]; then
    host_os="$(uname -s)"
    case "$host_os" in
        Darwin)
            # This path is provided inside the Docker Desktop / OrbStack VM. It
            # normally does not exist in the macOS host filesystem, so do not
            # test it with -S here.
            ssh_sock="/run/host-services/ssh-auth.sock"
            ;;
        Linux)
            ssh_sock="${SSH_AUTH_SOCK:-}"
            if [[ -z "$ssh_sock" || ! -S "$ssh_sock" ]]; then
                echo "kloot: -A/--ssh requested, but SSH_AUTH_SOCK is unset or not a socket on Linux; start or unlock an SSH agent (for example 1Password) and retry" >&2
                exit 1
            fi
            ;;
        *)
            echo "kloot: -A/--ssh is supported only on macOS and Linux (detected $host_os)" >&2
            exit 1
            ;;
    esac

    ssh_args=(
        --mount "type=bind,source=$ssh_sock,target=/ssh-agent"
        --env SSH_AUTH_SOCK=/ssh-agent
    )

    # This is host-key data only. Never mount ~/.ssh or OrbStack's private key.
    if [[ -f "$HOME/.orbstack/ssh/known_hosts" ]]; then
        orbstack_args=(
            --mount "type=bind,source=$HOME/.orbstack/ssh/known_hosts,target=/home/node/.orbstack/ssh/known_hosts,readonly"
        )
    fi
fi

mkdir -p "$HOME/.claude"
claudejson_args=()
[[ -f "$HOME/.claude.json" ]] && claudejson_args=(-v "$HOME/.claude.json:/home/node/.claude.json")

gitconfig_args=()
[[ -f "$HOME/.gitconfig" ]] && gitconfig_args=(-v "$HOME/.gitconfig:/home/node/.gitconfig:ro")

github_args=()
[[ -d "$HOME/Github" ]] && github_args=(-v "$HOME/Github:/home/node/Github")

workspace_home_args=()
[[ -d "$HOME/workspace" ]] && workspace_home_args=(-v "$HOME/workspace:/home/node/workspace")

# Ghostty inserts the host path when a CleanShot capture is dragged into the
# terminal. Mirror that narrowly scoped directory at the identical path so the
# agent can resolve it without exposing the rest of the host home directory.
cleanshot_media="$HOME/Library/Application Support/CleanShot/media"
cleanshot_args=()
if [[ -d "$cleanshot_media" ]]; then
    cleanshot_args=(
        --mount "type=bind,source=$cleanshot_media,target=$cleanshot_media,readonly"
    )
fi

case "$mode" in
    auto)   cmd=(claude --permission-mode auto) ;;
    safe)   cmd=(claude --permission-mode manual) ;;
    bypass) cmd=(claude --dangerously-skip-permissions) ;;
    shell)  cmd=(/bin/zsh) ;;
esac

if [[ "$ssh_forward" == 1 ]]; then
    # Verify the forwarded agent from inside the container before the harness
    # (or requested shell) starts. ssh-add exits 1 for an empty agent and 2 when
    # the socket cannot be reached.
    ssh_preflight='ssh-add -l >/dev/null 2>&1
ssh_add_status=$?
case "$ssh_add_status" in
    0) ;;
    1)
        echo "$0: -A/--ssh requested, but the forwarded SSH agent exposes no identities; unlock 1Password, enable its SSH agent, and ensure at least one key is eligible" >&2
        exit 1
        ;;
    *)
        echo "$0: -A/--ssh requested, but the forwarded SSH agent is unreachable at /ssh-agent; check that 1Password SSH agent integration and socket forwarding are enabled" >&2
        exit 1
        ;;
esac
exec "$@"'
    cmd=(/bin/sh -c "$ssh_preflight" kloot "${cmd[@]}")
fi

# The agent's own sandbox (bubblewrap) needs to create user namespaces, which
# Docker's default seccomp profile blocks. Without this the sandboxed commands
# fail with "bwrap: No permissions to create new namespace".
exec docker run --rm -it \
    --security-opt seccomp=unconfined \
    --name "$name" \
    --hostname "$(basename "$workspace")" \
    -v "$workspace:/workspace" \
    -v "$HOME/.claude:/home/node/.claude" \
    -v kloot-history:/commandhistory \
    ${claudejson_args[@]+"${claudejson_args[@]}"} \
    ${workspace_home_args[@]+"${workspace_home_args[@]}"} \
    ${github_args[@]+"${github_args[@]}"} \
    ${cleanshot_args[@]+"${cleanshot_args[@]}"} \
    ${gitconfig_args[@]+"${gitconfig_args[@]}"} \
    ${ssh_args[@]+"${ssh_args[@]}"} \
    ${orbstack_args[@]+"${orbstack_args[@]}"} \
    -e TERM="${TERM:-xterm-256color}" \
    -w /workspace \
    kloot:latest "${cmd[@]}"
